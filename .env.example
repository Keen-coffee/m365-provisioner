# Required
API_KEY=
UI_PASSWORD=
DEFAULT_DOMAIN=yourcompany.com

# Entra app registration (not needed when DRY_RUN=true)
TENANT_ID=
CLIENT_ID=
# Credential: use ONE of the following
CLIENT_SECRET=
# CERT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# CERT_PRIVATE_KEY_PATH=/run/secrets/cert.pem
# CERT_THUMBPRINT=

# Optional
UI_USERNAME=admin
ALLOWED_DOMAINS=
DEFAULT_USAGE_LOCATION=US
AUTO_APPROVE=false
DRY_RUN=true
